{
  "name": "@baselinelending/xlsx-calc",
  "version": "0.9.1",
  "description": "A simple xlsx formula calculator.",
  "main": "src/index.js",
  "repository": "git@github.com:baselinecapital/xlsx-calc.git",
  "author": "Sr Oshiro <fabio.oshiro@gmail.com>",
  "scripts": {
    "test": "mocha",
    "watch": "mocha --watch --reporter=min",
    "dev": "webpack --mode=development -w",
    "test-w": "mocha -w --check-leaks --sort",
    "build": "webpack --mode=production && sh deprecated-clones.sh"
  },
  "devDependencies": {
    "@formulajs/formulajs": "^2.6.3",
    "mocha": "^12.0.3",
    "nyc": "^18.0.0",
    "pre-commit": "^2.0.0",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "xlsx": "github:baselinecapital/sheetjs#d2f2e179636be22f3af3c306df7783ea10a2c7e3"
  },
  "tonicExampleFilename": "example_tonic.js",
  "pre-commit": [
    "build"
  ],
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  },
  "resolutions": {
    "**/@istanbuljs/load-nyc-config/js-yaml": "^4.3.2"
  }
}
